              "comment": {
                "color": "#ff5c7a"
              },
              "comment.doc": {
                "color": "#ff5c7a"
              },
              "constant": {
                "color": "#ff003c"
              },
              "function": {
                "color": "#fff36b"
              },
              "keyword": {
                "color": "#00f0ff"
              },
              "number": {
                "color": "#ff00a0"
              },
              "operator": {
                "color": "#00f0ff"
              },
              "string": {
                "color": "#00ff9f"
              },
              "variable": {
                "color": "#ff003c"
              }
            },
            "players": [
              {
                "cursor": "#fcee0a",
                "background": "#000000",
                "selection": "#fcee0a30"
              }
            ]
          }
