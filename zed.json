    {
      "$schema": "https://zed.dev/schema/themes/v0.1.0.json",
      "name": "Cyberpunk",
      "author": "archo",
      "themes": [
        {
          "name": "Cyberpunk",
          "appearance": "dark",
          "style": {
            "background": "#0a0a1290",
